# AgentVault MCP server (stdio)
# Copy to packages/mcp-server/.env or pass these through your MCP client config.

# The vault contract account (or the simulator vault id).
VAULT_ACCOUNT_ID=demo.agentvault.testnet

# The agent's private key. The MCP server only holds this agent key, never the owner key.
# It is an ed25519 function-call key restricted to request_payment on the vault.
AGENT_PRIVATE_KEY=ed25519:REPLACE_WITH_AGENT_PRIVATE_KEY

# near = talk to the contract over RPC. local-http = talk to the local simulator API.
AGENTVAULT_MODE=local-http
AGENTVAULT_API_URL=http://localhost:8787

# testnet | mainnet (ignored in local-http mode)
NEAR_NETWORK=testnet
NEAR_RPC_URL=
