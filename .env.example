# =============================================================================
# AgentVault · Docker Compose environment
# Copy to .env and edit. Everything has a safe local default; the demo needs
# no API key and makes no chain calls in local mode.
# =============================================================================

# --- Postgres (used by the compose db service) -------------------------------
POSTGRES_USER=agentvault
POSTGRES_PASSWORD=agentvault-local-password
POSTGRES_DB=agentvault

# --- Ports -------------------------------------------------------------------
API_PORT=8787
WEB_PORT=8080

# --- API mode ----------------------------------------------------------------
# local    : deterministic offline simulator, seeds a demo vault. Default.
# testnet  : reads a real deployed AgentVault contract, owner signs in browser.
# mainnet  : production mode. Harness is forced off. Real funds.
NEAR_NETWORK=local

# Optional custom RPC. Leave empty to use the public NEAR RPC for the network.
NEAR_RPC_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Demo / local simulator --------------------------------------------------
SEED_DEMO=true
DEMO_VAULT_ID=demo.agentvault.testnet
DEMO_OWNER_ID=demo-owner.testnet
DEMO_FUNDING_NEAR=250
LOCAL_MODE_ENABLED=true

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_MS=2500

# --- Red-team harness --------------------------------------------------------
# Enabled automatically in local mode. Never enable on mainnet.
HARNESS_ENABLED=true
HARNESS_PER_HOUR=3

# --- Cross-chain executor (optional, real NEAR Intents payouts) --------------
# Delegated hot key that reports settlement. It cannot create or approve requests.
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
EXECUTOR_POLL_MS=5000

# --- Web build ---------------------------------------------------------------
# The nginx container proxies /api to the API service, so /api is correct.
VITE_API_BASE=/api

# =============================================================================
# Everything below is optional. The one-command Docker demo above needs none
# of it. Fill a block only when you use that specific feature.
# =============================================================================

# --- Optional: deploy the contract to testnet (pnpm deploy:testnet) ----------
# A throwaway testnet account. It pays for the deploy and funds the vault.
# NEVER put a mainnet key here.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
VAULT_ACCOUNT_ID=
VAULT_FUNDING_NEAR=5
VAULT_WASM=build/contracts/vault.wasm
AGENT_NAME=Demo Research Agent
AGENT_PUBLIC_KEY=
AGENT_ALLOWANCE_NEAR=0.25
AGENT_POLICY_FILE=

# --- Optional: run the red-team harness against real testnet -----------------
# `pnpm harness --network testnet` reads NEAR_ACCOUNT_ID / NEAR_PRIVATE_KEY /
# VAULT_ACCOUNT_ID above. The API-hosted harness button uses HARNESS_OWNER_*.
HARNESS_OWNER_ACCOUNT_ID=
HARNESS_OWNER_PRIVATE_KEY=

# --- Optional: LLM demo agent (pnpm agent:llm) -------------------------------
# Any OpenAI-compatible endpoint. The deterministic demo never calls an LLM.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_TURNS=8

# --- Optional: MCP server / agent SDK (pnpm mcp, pnpm agent:*) ----------------
# The MCP server infers local-http when AGENTVAULT_API_URL is set, else near.
# local-http talks to the Docker API; near signs real requests with the agent key.
AGENTVAULT_MODE=
AGENTVAULT_API_URL=
# Agent function-call key. This is the ONLY key an agent may hold: it is
# protocol-restricted to `request_payment` on the vault. Never put an owner key here.
AGENT_PRIVATE_KEY=

# --- Optional: mainnet deploy (pnpm deploy:mainnet) --------------------------
# Real funds. Only after a full testnet rehearsal and an independent audit.
MAINNET_OWNER_ID=
MAINNET_PRIVATE_KEY=
MAINNET_VAULT_ID=
# Defaults to build/contracts/vault.wasm from `pnpm contract:build`.
VAULT_WASM_PATH=build/contracts/vault.wasm
