# =============================================================================
# AgentVault · Docker Compose environment
# Copy to .env and edit. Everything has a safe local default; the demo needs
# no API key and makes no chain calls in local mode.
# =============================================================================

# --- Postgres (used by the compose db service) -------------------------------
POSTGRES_USER=agentvault
POSTGRES_PASSWORD=agentvault-local-password
POSTGRES_DB=agentvault

# --- Ports -------------------------------------------------------------------
API_PORT=8787
WEB_PORT=8080

# --- API mode ----------------------------------------------------------------
# local    : deterministic offline simulator, seeds a demo vault. Default.
# testnet  : reads a real deployed AgentVault contract, owner signs in browser.
# mainnet  : production mode. Harness is forced off. Real funds.
NEAR_NETWORK=local

# Optional custom RPC. Leave empty to use the public NEAR RPC for the network.
NEAR_RPC_URL=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Demo / local simulator --------------------------------------------------
SEED_DEMO=true
DEMO_VAULT_ID=demo.agentvault.testnet
DEMO_OWNER_ID=demo-owner.testnet
DEMO_FUNDING_NEAR=250
LOCAL_MODE_ENABLED=true

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_MS=2500

# --- Red-team harness --------------------------------------------------------
# Enabled automatically in local mode. Never enable on mainnet.
HARNESS_ENABLED=true
HARNESS_PER_HOUR=3

# Real-chain harness funder. REQUIRED ONLY for `pnpm harness` against testnet.
# The key must be a throwaway testnet account. It is never used by the web app.
HARNESS_OWNER_ACCOUNT_ID=
HARNESS_OWNER_PRIVATE_KEY=

# --- Cross-chain executor (optional, real NEAR Intents payouts) --------------
# Delegated hot key that reports settlement. It cannot create or approve requests.
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
EXECUTOR_POLL_MS=5000

# --- Web build ---------------------------------------------------------------
# The nginx container proxies /api to the API service, so /api is correct.
VITE_API_BASE=/api
