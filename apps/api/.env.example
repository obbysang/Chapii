# AgentVault API · local development
# Copy to apps/api/.env or export these variables before `pnpm --filter @agentvault/api dev`.

NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info

# Postgres. `docker compose up db` exposes 5432.
DATABASE_URL=postgresql://agentvault:agentvault@localhost:5432/agentvault?schema=public
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# local | testnet | mainnet
NEAR_NETWORK=local
NEAR_RPC_URL=
INDEXER_POLL_MS=2500

# Local simulator. Creates a deterministic demo vault on startup.
LOCAL_MODE_ENABLED=true
SEED_DEMO=true
DEMO_VAULT_ID=demo.agentvault.testnet
DEMO_OWNER_ID=demo-owner.testnet
DEMO_FUNDING_NEAR=250

# Red-team harness. Force-off on mainnet.
HARNESS_ENABLED=true
HARNESS_PER_HOUR=3
# Testnet-only funder for real-chain harness runs. Use a throwaway account.
HARNESS_OWNER_ACCOUNT_ID=
HARNESS_OWNER_PRIVATE_KEY=

# Optional cross-chain executor. A hot key is allowed only for settlement reports.
EXECUTOR_ACCOUNT_ID=
EXECUTOR_PRIVATE_KEY=
ONECLICK_API_URL=https://1click.chaindefuser.com
ONECLICK_JWT=
EXECUTOR_POLL_MS=5000
