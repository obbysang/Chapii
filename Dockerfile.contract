# Builds and tests the AgentVault contracts, then exports the WASM artifacts.
# Usage:
#   docker build -f Dockerfile.contract --target export --output type=local,dest=build/contracts .
#
# The Rust version must satisfy the MSRV of the resolved dependency tree
# (near-sdk 5.30 -> rustc 1.95). Bump this tag when near-sdk is bumped.
FROM rust:1.95-slim AS builder
# Keep the build inside a modest memory budget: near-sdk with the
# unit-testing feature is expensive to compile.
ENV CARGO_BUILD_JOBS=1 \
    CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_PROFILE_RELEASE_DEBUG=0
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY contracts ./contracts
RUN cargo test --manifest-path contracts/Cargo.toml
RUN cargo build --manifest-path contracts/Cargo.toml --target wasm32-unknown-unknown --release
RUN mkdir -p /out \
    && cp contracts/target/wasm32-unknown-unknown/release/agentvault_vault.wasm /out/vault.wasm \
    && cp contracts/target/wasm32-unknown-unknown/release/agentvault_mock_ft.wasm /out/mock_ft.wasm

FROM scratch AS export
COPY --from=builder /out/ /
