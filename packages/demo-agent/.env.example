# AgentVault demo agents
# Copy to packages/demo-agent/.env or export before running.

# Runtime mode: local-http (simulator) or near (real contract).
AGENTVAULT_MODE=local-http
AGENTVAULT_API_URL=http://localhost:8787

# Required for `pnpm agent:good` / `pnpm agent:attack`.
VAULT_ACCOUNT_ID=demo.agentvault.testnet
AGENT_PRIVATE_KEY=ed25519:REPLACE_WITH_AGENT_PRIVATE_KEY

NEAR_NETWORK=testnet
NEAR_RPC_URL=

# Payee / attack fixtures (optional; defaults match the seeded demo vault).
DEMO_PAYEE_ADDRESS=merchant.testnet
DEMO_ATTACK_ADDRESS=0xdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# --- Optional LLM injection demo --------------------------------------------
# Everything deterministic works without this. `pnpm agent:llm` prints a clear
# message and exits if LLM_API_KEY is absent.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TURNS=8
