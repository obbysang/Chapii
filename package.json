{
  "name": "agentvault",
  "version": "1.0.0",
  "private": true,
  "description": "Policy-enforced treasury on NEAR for AI agents that spend money",
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter @agentvault/api dev",
    "harness": "node packages/harness/dist/cli.js",
    "demo": "pnpm --filter @agentvault/demo-agent demo",
    "agent:good": "pnpm --filter @agentvault/demo-agent good",
    "agent:attack": "pnpm --filter @agentvault/demo-agent attack",
    "agent:llm": "pnpm --filter @agentvault/demo-agent llm",
    "db:generate": "pnpm --filter @agentvault/api db:generate",
    "db:migrate": "pnpm --filter @agentvault/api db:migrate",
    "db:seed": "pnpm --filter @agentvault/api db:seed",
    "contract:build": "bash scripts/build-contract.sh",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts",
    "deploy:mainnet": "tsx scripts/deploy-mainnet.ts",
    "vault:lock": "tsx scripts/lock-vault.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
